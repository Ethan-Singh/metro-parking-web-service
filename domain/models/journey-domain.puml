@startuml
title Journey Planning and Toll Calculation - Conceptual Model
skinparam packageStyle rectangle

package "Journey Planning capability" {
  class JourneyRequest {
    origin : Place
    destination : Place
    departureTime : Instant
    modes / preferences
  }
  class Place {
    providerId
    name
    coordinates
    kind
  }
  class Itinerary {
    legs
    departureTime : Instant
    arrivalTime : Instant
    duration
  }
  class JourneyLeg {
    mode
    origin : Place
    destination : Place
    departureTime : Instant
    arrivalTime : Instant
  }
  interface TripPlannerPort
  class JourneyPlanningService
  JourneyPlanningService --> TripPlannerPort
  JourneyPlanningService --> JourneyRequest
  JourneyPlanningService --> Itinerary
  Itinerary o-- "1..*" JourneyLeg
  JourneyRequest --> Place
}

package "Toll capability" {
  class TollQuoteRequest {
    origin : Place
    destination : Place
    departureTime : Instant
    vehicleClass
    excludeTolls
  }
  class TollQuote {
    totalCost
    currency
    distance
    duration
    routeGeometry
    tollSegments
  }
  class TollSegment {
    road / toll point
    amount
    currency
  }
  interface TollCalculatorPort
  class TollCalculationService
  TollCalculationService --> TollCalculatorPort
  TollCalculationService --> TollQuoteRequest
  TollCalculationService --> TollQuote
  TollQuote o-- "0..*" TollSegment
}

note bottom
  Both capabilities may use a shared Place value concept internally,
  but provider request/response DTOs and adapters remain capability-specific.
  Trip Planner supplies public transport journey data; Toll Calculator
  supplies road routes and toll costs. Do not couple one API's schema to
  the other's domain model.
end note
@enduml
