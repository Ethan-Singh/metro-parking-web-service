@startuml
title Timetable Domain Overview
left to right direction
skinparam packageStyle rectangle
hide methods

package "Static timetable" {
  class ScheduleSnapshot
  class ClientScheduleManifest
  class ClientSchedulePackage
  class TimetableOffering
  ScheduleSnapshot --> ClientScheduleManifest : publishes
  ScheduleSnapshot --> ClientSchedulePackage : materializes by date
  ClientScheduleManifest o-- TimetableOffering
}

package "Client route planning" {
  class SavedTimetablePlan
  class TimetableRouteQuery
  class TimetableRouteOption
  SavedTimetablePlan --> TimetableRouteQuery
  TimetableRouteQuery --> TimetableRouteOption : bounded alternatives
}

package "Realtime overlay" {
  class RealtimeOverlaySnapshot
  class ServiceAlert
  class RealtimeTripUpdate
  RealtimeOverlaySnapshot o-- ServiceAlert
  RealtimeOverlaySnapshot o-- RealtimeTripUpdate
}

package "Opal fare estimates" {
  class OpalFareDataSnapshot
  class FareRulesRevision
  class FareProfile
  class OpalTimetableFareCalculator
  class FareEstimate
  OpalFareDataSnapshot --> FareRulesRevision
  OpalTimetableFareCalculator --> OpalFareDataSnapshot : prices against
  OpalTimetableFareCalculator --> FareRulesRevision : applies
  OpalTimetableFareCalculator --> FareProfile : uses
  OpalTimetableFareCalculator --> FareEstimate : produces
}

ClientSchedulePackage --> TimetableRouteQuery : searched locally
RealtimeOverlaySnapshot --> TimetableRouteOption : adds live context
TimetableRouteOption --> FareEstimate : optional estimate

note bottom
  Detailed models: schedule-domain.puml, route-planning.puml,
  realtime-domain.puml, and opal-fare-domain.puml.

  The backend ingests, normalizes, and publishes snapshots/overlays.
  The frontend searches locally and stores up to 20 small saved query plans
  in versioned localStorage; this data stays client-side unless app code sends it.
end note
@enduml
