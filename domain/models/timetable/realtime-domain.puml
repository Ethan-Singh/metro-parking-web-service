@startuml
title Timetable Realtime and Disruption Domain
skinparam packageStyle rectangle
hide methods

class RealtimeOverlaySnapshot {
  overlayVersion
  publishedAt : Instant
}
class RealtimeSourceState {
  feedKey
  schemaKey
  gtfsRealtimeVersion
  incrementality : FULL_DATASET | DIFFERENTIAL
  status : CURRENT | DEGRADED | UNAVAILABLE
  providerGeneratedAt : optional Instant
  lastAttemptAt : optional Instant
  retrievedAt : optional Instant
  lastSuccessfulAt : optional Instant
  errorCode : optional
}
class ServiceAlert {
  providerNamespace
  alertId
  header
  description
  cause
  effect
  severity : optional
  activePeriods
  translatedUrl : optional
  sourceUpdatedAt : optional Instant
}
class AlertTarget {
  providerNamespace
  agencyId : optional
  routeId : optional
  tripId : optional
  stopId : optional
  directionId : optional
  matchStatus : MATCHED | UNMATCHED | AMBIGUOUS
  matchedScheduleRefs : optional
}
class RealtimeTripUpdate {
  providerNamespace
  providerTripId
  providerRouteId : optional
  startDate : optional
  startTime : optional
  directionId : optional
  scheduleRelationship : SCHEDULED | ADDED | UNSCHEDULED | CANCELED | REPLACEMENT | SKIPPED | NO_DATA | UNKNOWN
  providerTimestamp : optional Instant
  delaySeconds : optional
  matchStatus : MATCHED | UNMATCHED | AMBIGUOUS
  scheduleTripId : optional namespaced static trip id
  scheduleRouteId : optional namespaced static route id
  scheduleSnapshotVersion : optional
  scheduleTripCandidates : optional namespaced candidates
}
class RealtimeVehiclePosition {
  providerNamespace
  matchStatus : MATCHED | UNMATCHED | AMBIGUOUS
  scheduleTripId : optional namespaced static trip id
  scheduleRouteId : optional namespaced static route id
  scheduleSnapshotVersion : optional
  scheduleTripCandidates : optional namespaced candidates
  providerTripId : optional
  vehicleId : optional
  latitude : optional
  longitude : optional
  bearing : optional
  speedMetresPerSecond : optional
  currentStopSequence : optional
  currentStatus : optional
  vehicleTimestamp : optional Instant
  occupancy : optional OccupancyStatus
  vehicleAttributes : optional TfnswVehicleAttributes
  carriages : CarriagePosition[]
}
class RealtimeStopUpdate {
  stopSequence : optional
  providerStopId : optional
  arrivalDelaySeconds : optional
  departureDelaySeconds : optional
  arrivalUncertaintySeconds : optional
  departureUncertaintySeconds : optional
  predictedArrival : optional Instant
  predictedDeparture : optional Instant
  departureOccupancy : optional OccupancyStatus
  scheduleRelationship : optional
  matchStatus : MATCHED | UNMATCHED | AMBIGUOUS
  scheduleStopId : optional namespaced stop id
}
class TfnswVehicleAttributes {
  airConditioned : optional boolean
  wheelchairCapacity : optional integer
  vehicleModel : optional
  performingPriorTrip : optional boolean
  specialAttributes : optional integer
}
class CarriagePosition {
  name : optional
  positionInConsist : integer
  occupancy : optional OccupancyStatus
  quietCarriage : optional boolean
  toilet : optional NONE | NORMAL | ACCESSIBLE
  luggageRack : optional boolean
}
enum OccupancyStatus {
  EMPTY
  MANY_SEATS_AVAILABLE
  FEW_SEATS_AVAILABLE
  STANDING_ROOM_ONLY
  CRUSHED_STANDING_ROOM_ONLY
  FULL
  NOT_ACCEPTING_PASSENGERS
  UNKNOWN
}
class ScheduleJoinResult {
  status : MATCHED | UNMATCHED | AMBIGUOUS
  scheduleFeedKey : optional
  matchedTripRef : optional
}

RealtimeOverlaySnapshot o-- "1..*" RealtimeSourceState
RealtimeOverlaySnapshot o-- "0..*" ServiceAlert
RealtimeOverlaySnapshot o-- "0..*" RealtimeTripUpdate
RealtimeOverlaySnapshot o-- "0..*" RealtimeVehiclePosition
ServiceAlert o-- "1..*" AlertTarget
RealtimeTripUpdate --> ScheduleJoinResult
ScheduleJoinResult --> "0..1" ScheduledTrip
RealtimeTripUpdate o-- "0..*" RealtimeStopUpdate
RealtimeStopUpdate --> "0..1" ScheduledStopCall
RealtimeVehiclePosition --> "0..1" ScheduledTrip : namespace-scoped join
RealtimeVehiclePosition o-- "0..*" CarriagePosition
RealtimeVehiclePosition --> "0..1" TfnswVehicleAttributes
RealtimeVehiclePosition --> OccupancyStatus
CarriagePosition --> OccupancyStatus

note right of ScheduleJoinResult
  Match only against the active published timetable snapshot
  and the explicit realtime-to-schedule feed mapping. Require
  provider trip ID, optional route ID agreement, and start date
  when supplied. Without a date, match only if exactly one
  scheduled instance remains in the snapshot. Preserve ambiguous
  candidate ids; never pick one arbitrarily. Stop calls require
  an exact provider stop id and sequence within the matched trip.
end note

note bottom of ServiceAlert
  Replacement-service relationships are established from
  validated alert targets/periods or reviewed mappings.
  Do not infer a train-to-bus replacement from names alone.
end note

note left of RealtimeOverlaySnapshot
  Keep this overlay independently refreshed from the static
  schedule. Retain last-known-good data per source and report
  attempt/retrieval timestamps. No domain freshness threshold
  is imposed; missing updates never become zero delay. Poll on
  a controlled backend schedule, never on a client request.
end note

note right of RealtimeVehiclePosition
  Keep vehicle event timestamp, feed timestamp, and retrieval time.
  A location may be absent or unmatched; retain it without joining
  solely on an unscoped trip ID.
end note

note bottom of RealtimeSourceState
  Preserve GTFS-Realtime header version and incrementality.
  Full datasets replace that source's prior entity set; apply
  differential updates and deletions only within their source
  namespace and only after their semantics are validated.
end note

note right of CarriagePosition
  Decode extensions with a pinned schema selected from observed
  wire fields. Captured variants use different extension numbers
  (1006/1999 versus 1007); preserve the selected schema key and
  do not combine generated protobuf definitions across variants.
end note
@enduml
